# Copy to packages/backend/.env and fill in. The file .env is git-ignored.

# GCP project that holds the BigQuery datasets and runs Gemini (Vertex AI)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI region for Gemini; use the region of your BigQuery datasets
GEMINI_LOCATION=europe-central2

# Gemini model (must be available in GEMINI_LOCATION)
GEMINI_MODEL=gemini-2.5-flash

# Optional: a separate credentials file instead of the default ADC (see SETUP.md)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/adc-private.json

# Optional: server port and host (defaults 3001 and 0.0.0.0)
# PORT=3001
# HOST=0.0.0.0
